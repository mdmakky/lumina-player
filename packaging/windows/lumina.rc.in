#include <winver.h>
IDI_ICON1 ICON "@LUMINA_ICO@"
VS_VERSION_INFO VERSIONINFO
FILEVERSION @LUMINA_RC_VER@
PRODUCTVERSION @LUMINA_RC_VER@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Lumina Player"
      VALUE "FileDescription", "Lumina Player"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "OriginalFilename", "lumina.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
